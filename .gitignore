# ---- IDE / OS ----
.vscode/
.DS_Store
**/.DS_Store

# ---- Launcher-managed / per-player ----
.curseclient
/minecraftinstance.json
options.txt
usercache.json
usernamecache.json
foolproof.json
nutritionalbalance.data
/keybinding presets/

# ---- Logs, crash dumps, debug output ----
*.log
*.log.gz
hs_err_pid*.log
replay_pid*.log
quantified-api.log
crash-reports/
logs/
att-debug/
wmd_debug/
streamsreflowing-stall*
/dumps/

# ---- Worlds and generated output ----
saves/
downloads/
screenshots/
local/
fancymenu_data/
modernfix/
moonlight-global-datapacks/
patchouli-books/
visual_keybinder/
xaero/
XaeroWaypoints**/
/.cache/
/.ai/

# ---- Mixin / native caches ----
.mixin.out/
**/.mixin.out/
/EffekseerNativeForJava.dll
libEffekseerNativeForJava.dylib

# ---- Mod jars: fetched by ./fetch.sh from mods.json ----
mods/*.jar
# Kept in git ("repo" entries in mods.json). Own mods:
!mods/winterheart*.jar
!mods/seppuku-*.jar
!mods/packfinder-*.jar
# Third-party jars kept in git:
!mods/BetterSnowyFeatures-1.0.4-1.20.1-FULL.jar
!mods/tacz-firstperson-compat-forge-1.20.1-1.1.4.jar

# ---- Resource packs: fetched by ./fetch.sh from mods.json ----
resourcepacks/*.zip

# ---- Mods not shipped with the pack ----
mods/cipherwright-0.3.0-1.20.1.jar
mods/dumpeverything-1.0-SNAPSHOT.jar

# ---- Config: runtime-only paths ----
config/spark/tmp/
config/spark/activity.json
config/spark/*.sparkheap
config/spark/*.sparkprofile
config/xaero/
config/chloride-client.json
config/oculus.properties
config/packetfixer.properties
config/indigo-renderer.properties
config/defaults.properties
config/embeddium-fingerprint.json
config/fml.toml
config/vmp.properties
config/flywheel-client.toml
config/fabric/indigo-renderer.properties
config/ironchests/defaults.properties
config/asyncparticles/asyncparticles-mixin.properties
config/jei/ingredient-list-mod-sort-order.ini
config/QuantifiedAPI/cache/
config/worldedit/.archive-unpack/
config/worldedit/worldedit.properties

# ---- Config: written by mods, not settings (not all come back on launch) ----
config/orespawn-guide/
config/konkrete/locals/
config/bettercaves/**/README.txt
config/streamsreflowing/bank_*/examples/
config/streamsreflowing/bank_*/GUIDE.md
config/streamsreflowing/bank_*/README.md
config/streamsreflowing/bank_features/.seeded_defaults
config/streamsreflowing/bank_features/.withdrew_*
config/starterkit/descriptions/
config/starterkit/kits/inactive/
config/fancymenu/ui_themes/
config/fancymenu/layout_editor/
config/fancymenu/legacy_checklist.txt
config/fancymenu/user_variables.db
config/worldedit/sessions/

# ---- Schematics not loaded into a datapack ----
# Only the structure templates in datapacks/winterheart_structures are used by the game.
schematics/
*.litematic
# Keep only the WorldEdit sources that python/structures/export_structures.sh needs
config/worldedit/schematics/*
!config/worldedit/schematics/watchtower.nbt
!config/worldedit/schematics/shipwreck.schem
!config/worldedit/schematics/shipwreck_chest.snbt

# ---- Backups (git history covers these) ----
tacz_backup/
backups/
*.bak
*.backup
*backup*.zip

# ---- TACZ ----
# TACZ exports its default gun pack here (datapacks/winterheart_tacz trims it)
tacz/tacz_default_gun/
tacz/.export-state.json

# ---- Build output ----
__pycache__/
*.pyc
# Mod sources (built jars are copied into mods/)
mod-src/*/build/
mod-src/*/.gradle/
mod-src/*/run/
mod-src/*/bin/
# Pack publishing
python/publish/build/
python/publish/.gradle/
# Rust tools
/tools/*/target/
